# Firebrat local credentials — copy to backend/.env and fill in
# Loaded automatically by backend/firebrat/config.py (_load_dotenv)

# LLM (Stage 2) — nano-gpt or any OpenAI-compatible endpoint
MODEL_API_KEY=sk-nano-...
# NANO_API_KEY=sk-nano-...        # alias for MODEL_API_KEY
# NANO_API_URL=https://nano-gpt.com/api/v1
# FIREBRAT_SPARK_MODEL=deepseek/deepseek-v4-flash
# FIREBRAT_DEEPSEEK_MODEL=deepseek/deepseek-v4-pro:thinking

# Telegram progress pings (optional but recommended for long runs)
# TELEGRAM_BOT_TOKEN=8338741962:AAF...
# TELEGRAM_CHAT_ID=5765775772

# HuggingFace cache (avoid small home quota)
# HF_HOME=/scratch/sroy85/.cache/huggingface

# Pipeline / server paths (usually leave defaults)
# FIREBRAT_OUTPUT_DIR=backend/output
# FIREBRAT_UPLOAD_DIR=backend/uploads
# FIREBRAT_JOBS_DB=backend/jobs.sqlite3

# Split conda envs on dev cluster (single-env containers ignore these)
# FIREBRAT_EXTRACT_PY=/scratch/sroy85/conda-envs/firebrat-extract/bin/python
# FIREBRAT_TTS_PY=/scratch/sroy85/conda-envs/firebrat-tts/bin/python
# FIREBRAT_CONVERT_PY=/scratch/sroy85/conda-envs/firebrat-extract/bin/python

# Firebase FCM (optional — see docs/FIREBASE.md)
# FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
