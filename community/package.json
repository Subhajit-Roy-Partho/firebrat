{
  "name": "firebrat-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firebrat Community \u2014 public-domain audiobook library (Vite + Firebase + Internet Archive).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/ia.test.mjs test/works.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-firebrat-rules \"node --test test/rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "vite": "8.3.4"
  }
}
