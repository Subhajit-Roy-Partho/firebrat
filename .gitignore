# Source books (large binaries, kept in working dir but not in git history)
/*.pdf
/input/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# Generated book packages (large binary output, regenerable from source PDF)
backend/output/
*.wav
*.m4a
*.mp3
!backend/voice/narrator_ref.wav

# Job queue runtime state (server/jobs.py, backend/server/routes/jobs.py)
backend/jobs.sqlite3
backend/uploads/

# Local credentials — never commit these
.env
backend/.env

# HuggingFace / model caches if ever pointed inside repo
.cache/
hf_cache/

# Flutter / Dart
frontend/firebrat_app/.dart_tool/
frontend/firebrat_app/.flutter-plugins
frontend/firebrat_app/.flutter-plugins-dependencies
frontend/firebrat_app/build/
frontend/firebrat_app/android/.gradle/
frontend/firebrat_app/android/.kotlin/
frontend/firebrat_app/android/local.properties
frontend/firebrat_app/**/GeneratedPluginRegistrant.*
frontend/firebrat_app/.pub-cache/
frontend/firebrat_app/.pub/
frontend/firebrat_app/*.iml

# Editors / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
secrets/

# Local device test evidence and source-book fixtures
/tmp/
# Xcode per-user workspace state
**/xcuserdata/
# Generated Flutter iOS build configuration
frontend/firebrat_app/ios/Flutter/Generated.xcconfig
frontend/firebrat_app/ios/Flutter/flutter_export_environment.sh
frontend/firebrat_app/ios/Flutter/Flutter.podspec
frontend/firebrat_app/ios/Flutter/ephemeral/

# PWA package/build tooling
frontend/firebrat_pwa/node_modules/
frontend/firebrat_pwa/.vite/
*.xcresult/

# Locally rebuilt native model frameworks
frontend/FirebratNative/Packages/LlamaIOS/Artifacts/

# Original, short narrated sample published with the PWA
!frontend/firebrat_pwa/public/demo/**/*.wav
!backend/server/static/pwa/demo/**/*.wav

# Desktop backend installer build products (never package user data)
installer/server/dist/
installer/server/build/
installer/server/*.spec
