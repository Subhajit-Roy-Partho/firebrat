# Copy to .env (docker compose reads it automatically). ./run.sh writes one for you.

# Stage-2 LLM (cloud). Any OpenAI-compatible endpoint works; see docs/LLM_PROVIDERS.md.
MODEL_API_KEY=

# How many books may convert at the same time. Extra uploads wait in the queue.
# Each running job holds several GB of RAM (and GPU memory on the GPU image),
# so keep 1 unless the host has the headroom. Range 1-16; invalid values fall back to 1.
FIREBRAT_MAX_CONCURRENT_JOBS=1

# Largest accepted upload, in MB.
FIREBRAT_MAX_UPLOAD_MB=500
